{"updatedAt":"2026-08-01T14:35:47.040Z","createdAt":"2026-07-31T03:58:50.690Z","id":"EdJF5yqC1ZJogHzG","name":"Section 1 - Feedback Pipeline","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,0],"id":"fba389d6-fe36-435e-89df-c29677e94b8c","name":"TriggerManual"},{"parameters":{"url":"https://learn.app.n8n.cloud/webhook/course/n8n103/feedback","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-Assessment-ID","value":"52635d5b72a6324c894362d240649ce7"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[224,0],"id":"8f8584a0-966f-4042-a679-b1960b8c21cc","name":"GetFeedback","credentials":{"httpHeaderAuth":{"id":"SnkAOUDJcllkPosL","name":"n8n Academy API Key"}}},{"parameters":{"maxItems":3},"type":"n8n-nodes-base.limit","typeVersion":1,"position":[448,0],"id":"32fbbcf0-616a-4120-b839-285401d0aff3","name":"SetFeedbackItem"},{"parameters":{"promptType":"define","text":"=Customer: {{ $json.customer_name }}\nFeedback: {{ $json.message }}\n\nClassification:\n- Sentiment: {{ $json.sentiment }}\n- Topic: {{ $json.topic }}\n- Urgency: {{ $json.urgency }}\n- Key Issue: {{ $json.key_issue }}","messages":{"messageValues":[{"message":"=You are a helpful customer service assistant.\n\nRead the following customer feedback and write a brief, professional response acknowledging their message.\n\nUse the classification to guide your tone:\n- For negative sentiment or high urgency: Be empathetic and apologetic\n- For positive sentiment: Be appreciative and warm\n- For billing or support topics: Offer specific next steps, if its very negative, make sure to include that a specialist will reach out to resolve the issue, but don't offer resolution yet as this has to be investigated first.\n- Add this to footer\n  - Jan Wendell Mesia\n  - Customer Representative"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.9,"position":[1248,0],"id":"f1662c6f-6bf8-4e22-af90-f7c107af4deb","name":"GenerateReply"},{"parameters":{"model":"openai/gpt-oss-20b","options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatGroq","typeVersion":1,"position":[1328,224],"id":"1b2ad4b9-5336-49c2-97b2-f2eb39820128","name":"gpt-oss-120b","credentials":{"groqApi":{"id":"7S3nVfV5U2nGphpg","name":"Groq account"}}},{"parameters":{"method":"POST","url":"https://learn.app.n8n.cloud/webhook/course/n8n103/reply","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-Assessment-ID","value":"52635d5b72a6324c894362d240649ce7"}]},"sendBody":true,"bodyParameters":{"parameters":[{"name":"feedback_id","value":"={{ $('SetFeedbackItem').item.json.feedback_id }}"},{"name":"generated_reply","value":"={{ $json.text }}"},{"name":"model_used","value":"opaneai/gpt-oss-120b"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1600,0],"id":"82cff86f-96c7-4980-8e9c-1ef42b423158","name":"SendGeneratedReply","credentials":{"httpHeaderAuth":{"id":"SnkAOUDJcllkPosL","name":"n8n Academy API Key"}}},{"parameters":{"promptType":"define","text":"=Customer: {{ $json.customer_id }}\nFeedback: {{ $json.message }}","hasOutputParser":true,"messages":{"messageValues":[{"message":"You are a customer feedback analyst.\n\nAnalyze the feedback and classify it by:\n1. Sentiment: Is the customer positive, neutral, or negative?\n2. Topic: Is this about billing, product, support, or general?\n3. Urgency: Based on the tone and content, is this low, medium, or high urgency?\n4. Key Issue: Summarize the main point .\n\nOutput Requirements \nsentiment: Must be exactly one of: positive, neutral, or negative\ntopic: Must be exactly one of: billing, product, support, or general\nurgency: Must be exactly one of: low, medium, or high\nkey_issue: A two-sentence summary of the main issue or praise\n\nExample output format: \n{\n  \"sentiment\": \"positive\",\n  \"topic\": \"product\",\n  \"urgency\": \"low\",\n  \"key_issue\": \"Customer is satisfied with the product\"\n}"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.9,"position":[672,0],"id":"ccabf2fb-31b3-49dc-a928-18b4599eb3ba","name":"ClassifyFeedback","retryOnFail":true},{"parameters":{"model":"openai/gpt-oss-20b","options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatGroq","typeVersion":1,"position":[688,224],"id":"04a7ea0b-0369-4cfc-9a56-973ba7ec9c6a","name":"gpt-oss-20b","credentials":{"groqApi":{"id":"7S3nVfV5U2nGphpg","name":"Groq account"}}},{"parameters":{"assignments":{"assignments":[{"id":"490dfb66-6a59-4dee-81b8-be1355ba79c0","name":"feedback_id","value":"={{ $('SetFeedbackItem').item.json.feedback_id }}","type":"string"},{"id":"10b0de9b-35a5-45b1-b3e2-929364dbe10c","name":"customer_name","value":"={{ $('SetFeedbackItem').item.json.customer_name }}","type":"string"},{"id":"78ec8ed6-0124-4d40-bf72-6b35974bb4f6","name":"message","value":"={{ $('SetFeedbackItem').item.json.message }}","type":"string"},{"id":"6a82c9c3-f5b1-4d45-88ce-4d3e3ba332ef","name":"sentiment","value":"={{ $('ClassifyFeedback').item.json.output.sentiment }}","type":"string"},{"id":"ea0ad6b1-b97c-4744-bd85-497bcbe1ff5c","name":"topic","value":"={{ $('ClassifyFeedback').item.json.output.topic }}","type":"string"},{"id":"977bf5fb-1774-47a4-9f19-6806a1f4d9e7","name":"urgency","value":"={{ $('ClassifyFeedback').item.json.output.urgency }}","type":"string"},{"id":"819bc96c-9cf5-4720-9b4b-997fc926cfdb","name":"key_issue","value":"={{ $('ClassifyFeedback').item.json.output.key_issue }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1024,0],"id":"9631239e-dc53-484e-9d4d-1172f0d16403","name":"SetClassificationResult"},{"parameters":{"jsonSchemaExample":"{\n  \"sentiment\": \"positive\",\n  \"topic\": \"product\",\n  \"urgency\": \"low\",\n  \"key_issue\": \"Customer is satisfied with the product\"\n}"},"type":"@n8n/n8n-nodes-langchain.outputParserStructured","typeVersion":1.3,"position":[816,224],"id":"d3097116-192d-415d-ae5b-92671869a6a1","name":"Structured Output Parser"},{"parameters":{"content":"# Feedback Pipeline\n\nOwned By: Jan Wendell Mesia\nLast Updated: 08/01/2026\n\nFetches customer feedback from the Academy API, classifies it\nusing structured output, and generates a tailored reply.\n\n## Flow\n1. GetFeedback: Fetches feedback items from Academy endpoint\n2. SetFeedbackItem: Limits to first item for processing\n3. GenerateReply: AI generates initial response\n4. ClassifyFeedback: AI classifies sentiment, topic, urgency\n5. SetClassificationResult: Extracts parsed classification\n6. GenerateReply (updated): Produces classification-aware reply\n7. SendGeneratedReply: Posts result to Academy for grading\n\n## Model\n- Groq: llama-3.3-70b-versatile (or your preferred model)\n\n## Dependencies\n- Requires: n8n Academy API Key credential, Groq API credential\n\nPart of: n8n Foundations Course, Section 4","height":704,"width":768},"type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[0,-752],"id":"ce155740-f097-41eb-9dcd-3266ad41f8e8","name":"Sticky Note"}],"connections":{"TriggerManual":{"main":[[{"node":"GetFeedback","type":"main","index":0}]]},"GetFeedback":{"main":[[{"node":"SetFeedbackItem","type":"main","index":0}]]},"SetFeedbackItem":{"main":[[{"node":"ClassifyFeedback","type":"main","index":0}]]},"gpt-oss-120b":{"ai_languageModel":[[{"node":"GenerateReply","type":"ai_languageModel","index":0}]]},"GenerateReply":{"main":[[{"node":"SendGeneratedReply","type":"main","index":0}]]},"ClassifyFeedback":{"main":[[{"node":"SetClassificationResult","type":"main","index":0}]]},"gpt-oss-20b":{"ai_languageModel":[[{"node":"ClassifyFeedback","type":"ai_languageModel","index":0}]]},"SetClassificationResult":{"main":[[{"node":"GenerateReply","type":"main","index":0}]]},"Structured Output Parser":{"ai_outputParser":[[{"node":"ClassifyFeedback","type":"ai_outputParser","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate","availableInMCP":false},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"nodeGroups":[],"pinData":{"SetFeedbackItem":[{"json":{"feedback_id":"FB-002","customer_id":"CUST-002","customer_name":"TechStart Inc","channel":"support_ticket","message":"This is the third time I'm reaching out about the billing issue. I was charged twice last month and nobody has resolved it yet. Very frustrated with the lack of response. Considering switching providers.","received_at":"2026-01-19T09:15:00.000Z"}}]},"versionId":"33a1b471-8293-4af1-a8fc-2dca2533a3a9","activeVersionId":null,"versionCounter":280,"triggerCount":0,"sourceWorkflowId":null,"tags":[{"updatedAt":"2026-07-28T11:27:34.879Z","createdAt":"2026-07-28T11:27:34.879Z","id":"ffYL0yoxdNLYKHg4","name":"n8n103"}],"shared":[{"updatedAt":"2026-07-31T03:58:50.692Z","createdAt":"2026-07-31T03:58:50.692Z","role":"workflow:owner","workflowId":"EdJF5yqC1ZJogHzG","projectId":"JYyiAQWuJt5wnZhD","project":{"updatedAt":"2026-07-25T19:21:11.253Z","createdAt":"2026-07-25T19:19:13.063Z","id":"JYyiAQWuJt5wnZhD","name":"Jan Wendell Mesia <wendellsmesia@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"09ff975c-0074-4919-976c-b469d160f9db"}}],"versionMetadata":{"name":null,"description":null}}